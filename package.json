{
  "name": "thunderbird-omemo",
  "version": "0.1.13",
  "private": true,
  "description": "OMEMO end-to-end encryption for XMPP in Thunderbird Chat, via a WebExtension Experiment.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/**/*.test.js\"",
    "lint": "echo \"(add eslint config)\" && exit 0",
    "build": "node scripts/build.mjs",
    "package": "node scripts/package.mjs",
    "updates": "node scripts/updates.mjs"
  },
  "updates": {
    "link": "https://github.com/precisioncrab/thunderbird-omemo/releases/download/v{version}/thunderbird-omemo-{version}.xpi",
    "out": "updates.json"
  },
  "dependencies": {
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=22"
  }
}
